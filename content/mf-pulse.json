  "definitions": [
    {
      "k": "AUM",
      "v": "Assets under management at the end of the month: everything the industry holds, valued at that day's prices."
    },
    {
      "k": "AAUM",
      "v": "The quarterly average, which is what fund houses are ranked on. Averaging stops one good day deciding the table."
    },
    {
      "k": "Net inflow",
      "v": "What came in minus what went out. A negative number means more people sold than bought."
    },
    {
      "k": "SIP contribution",
      "v": "The money collected through systematic investment plans in the month. The closest thing India has to a national savings heartbeat."
    },
    {
      "k": "Passive",
      "v": "Index funds and exchange traded funds, across equity, debt, gold and silver. A fund that copies an index instead of picking."
    },
    {
      "k": "SIF",
      "v": "Specialised investment funds, SEBI's new category between mutual funds and PMS. Minimum investment ₹10 lakh, so not a retail product."
    },
    {
      "k": "Folio",
      "v": "One account with one fund house. You can hold several, so folios count accounts and not people."
    }
  ],
